        {
            "parameters": {
                "mode": "runOnceForEachItem",
                "jsCode": "// Sayfa kaynağındaki tüm metni alıyoruz\nconst html = $node[\"HTTP Request\"].json[\"data\"]; \n\n// 1. Fiyatı Bul (Regex ile: \"discountedPrice\":182.18 gibi yapıları arar)\nconst priceMatch = html.match(/\"discountedPrice\"\\s*:\\s*(\\d+(\\.\\d+)?)/) || \n                   html.match(/\"customerPrice\"\\s*:\\s*(\\d+(\\.\\d+)?)/) ||\n                   html.match(/\"salePrice\"\\s*:\\s*(\\d+(\\.\\d+)?)/);\n\n// 2. İsmi Bul (meta tag içindeki temiz başlığı alır)\nconst nameMatch = html.match(/<title>(.*?)<\\/title>/);\n\nlet urunAdi = \"İsim Bulunamadı\";\nif (nameMatch && nameMatch[1]) {\n    // İdefix başlığındaki gereksiz kısımları temizle\n    urunAdi = nameMatch[1].split('|')[0].split('-')[0].replace('fiyatı, yorumları ve özellikleri', '').trim();\n}\n\nlet fiyat = 0;\nif (priceMatch && priceMatch[1]) {\n    fiyat = parseFloat(priceMatch[1]);\n}\n\nreturn {\n    Urun_Adi: urunAdi,\n    Fiyat: fiyat,\n    Tarih: new Date().toLocaleString('tr-TR')\n};"
            },
